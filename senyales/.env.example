# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# ---- Public links (leave empty to hide) ----
NEXT_PUBLIC_SHOP_URL=https://your-store.myshopify.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ---- Email signup destination (set ONE option) ----
# Option 1: save signups as Shopify customers subscribed to email marketing.
# Shopify admin → Settings → Apps and sales channels → Develop apps → create app
# → Admin API scopes: write_customers, read_customers → install → copy the token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Option 2: send signups to any webhook (Google Apps Script, Formspree, Zapier…)
SIGNUP_WEBHOOK_URL=
